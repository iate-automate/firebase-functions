# Copy to .env (gitignored) and fill in real values before deploying.
# Firebase Functions v2 reads this file locally at `firebase deploy` time —
# it is not set via the Firebase Console.

# Airtable REST API root — same for every Airtable integration, not a secret.
AIRTABLE_API=https://api.airtable.com/v0/

# Base IDs — note the trailing slash, the code concatenates these directly
# with the table name (e.g. AIRTABLE_API + AIRTABLE_BASE_MAIN + "Enrolments/...").
AIRTABLE_BASE_MAIN=app1zklQRTdY0dT15/
# Only needed if webinar endpoints are still in use — webinars are defunct
# as of Aug 2026, so this can likely be left unset.
AIRTABLE_BASE_ONLINE=app3fxAy2CK0ZgOxA/

# Personal Access Token — needs read+write on the Main base (PATCHes the
# Contract field on Enrolments). Different from the frontend's read-only
# key — use a fresh, dedicated PAT, not the same one.
AIRTABLE_API_KEY=
