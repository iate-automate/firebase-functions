{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "runtime": "nodejs22",
      "deployment": {
        "memory": "2GiB",
        "timeoutSeconds": 540
      }
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
